<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore exposing internal representations, heavily used in Spring configuration and DTOs -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    
    <!-- Ignore catching Exception, common when wrapping third-party SDKs like MinIO -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION" />
    </Match>
</FindBugsFilter>
