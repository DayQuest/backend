# DayQuest Environment Configuration Example
# Copy this file to stack.env and fill in your values

# Server Ports
USER_SERVER_PORT=8081
API_SERVER_PORT=8080
EUREKA_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888
NOTIFICATION_SERVER_PORT=8085
QUEST_SERVER_PORT=8083
AUTH_SERVER_PORT=8084

# Database Configuration
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# RabbitMQ Configuration
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# PgAdmin Configuration
PGADMIN_EMAIL=admin@example.com

# GitHub Token (for config-server if using private repo)
GITHUB_TOKEN=your_github_token

# JWT Secret (generate a secure random string, min 256 bits)
JWT_SECRET=your_jwt_secret_min_64_characters_long_for_security

# Mail Configuration
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password

# Monitoring - Grafana Admin Password
GRAFANA_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# ============================================
# REDIS CONFIGURATION (Enterprise Caching)
# ============================================
# Enable Redis for distributed caching and rate limiting
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# CORS Allowed Origins (comma-separated, for production)
CORS_ALLOWED_ORIGINS=https://dayquest.de,https://app.dayquest.de

